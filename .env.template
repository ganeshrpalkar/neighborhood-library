# FastAPI App — Environment Variable Template
# Copy to .env and fill in values. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# ────────────────────────────────────────────────────────────
# Core
# ────────────────────────────────────────────────────────────
ENVIRONMENT=local                          # local | staging | production
DEBUG=false                                # true enables docs, verbose logging, CORS for localhost
ENABLE_DOCS=false                          # true enables /docs and /redoc
ALLOWED_HOSTS=["*"]                        # list of allowed Host headers

# ────────────────────────────────────────────────────────────
# Security
# ────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME                       # Required in non-local envs. Use: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME                   # HS256 signing key. Use: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# ────────────────────────────────────────────────────────────
# PostgreSQL
# ────────────────────────────────────────────────────────────
# SQLAlchemy connection URL. Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql+psycopg://library:library@localhost:5432/library
# Engine tuning (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false                              # true logs all SQL (dev only)

# ────────────────────────────────────────────────────────────
# Redis
# ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1         # Redis connection URL
REDIS_KEY_PREFIX=app                       # Prefix for all Redis keys
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

# ────────────────────────────────────────────────────────────
# CORS
# ────────────────────────────────────────────────────────────
# Set CORS_ALLOWED_ORIGINS to a comma-separated list or JSON array.
# Leave empty + set DEBUG=true for automatic localhost origins.
# Set to "*" to allow all origins (not recommended for production).
CORS_ALLOWED_ORIGINS=https://app.example.com
# CORS_ALLOW_CREDENTIALS=true             # Default: true when origins are set

# ────────────────────────────────────────────────────────────
# Celery
# ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERYD_TASK_SOFT_TIME_LIMIT=1000          # Seconds before soft timeout

# ────────────────────────────────────────────────────────────
# Logging
# ────────────────────────────────────────────────────────────
LOG_FILE=/tmp/app_fastapi.log
DEBUG_LOGFILE=/tmp/app_fastapi_debug.log
CELERY_LOGFILE=/tmp/app_celery.log
LOGFILE_SIZE=5242880                       # 5MB
LOGFILE_COUNT=5
SERVICE_NAME=fastapi-app
SERVICE_VERSION=1.0.0
ENABLE_REQUEST_BODY_LOGGING=true
ENABLE_RESPONSE_BODY_LOGGING=true

# ────────────────────────────────────────────────────────────
# Runtime
# ────────────────────────────────────────────────────────────
THREADPOOL_MAX_THREADS=40
GUNICORN_WORKERS=2                         # Number of gunicorn workers (set in container)
CELERY_CONCURRENCY=2                       # Celery worker concurrency (set in container)

# ────────────────────────────────────────────────────────────
# Optional features
# ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=false                   # Enable SlowAPI rate limiting
RATE_LIMIT_DEFAULT=100/minute
PROMETHEUS_METRICS_ENABLED=false           # Expose /metrics endpoint

# ────────────────────────────────────────────────────────────
# Email (stub by default — configure for real sending)
# ────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
